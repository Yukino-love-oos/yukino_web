<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 服务器暂时是明文 HTTP（没有域名/证书），这里放开，避免 WebView 直接白屏 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
