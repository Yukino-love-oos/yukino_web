# ============================================================
#  复制为 .env 后填写。切勿把 .env 提交进 Git。
#  Copy to .env and fill in. NEVER commit .env.
# ============================================================

# ---------- 思考模型（LLM）----------
# ollama = 本地大模型（默认）；deepseek = 云端 API；mock = 离线假模型
LLM_PROVIDER=ollama

# 本地 ollama（LLM_PROVIDER=ollama 时生效，不需要 API Key）
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2:7b
# 生成完多久释放显存。8G 卡上和 GPT-SoVITS 抢显存：
#   5m  = 保留 5 分钟（对话顺畅，但 TTS 期间 LLM 只有 8 tok/s）
#   0   = 用完立刻卸载（TTS 能拿回显存，代价是下轮重新加载 2~8s）
OLLAMA_KEEP_ALIVE=5m
LLM_MAX_TOKENS=240
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.8
LLM_HISTORY_TURNS=6
# 台词不是日语时自动重试一次（qwen2:7b 常把 <ja> 写成中文，
# 而 GPT-SoVITS 用 text_lang=ja 念中文会出乱码音）
LLM_REPAIR_JA=true

# 云端 API（LLM_PROVIDER=deepseek 时才需要填）
# 去 https://platform.deepseek.com/api_keys 新建一个 Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- GPT-SoVITS 语音服务 ----------
GSV_API_BASE=http://127.0.0.1:9880
# 参考音频：必须与 GSV_PROMPT_TEXT 的内容逐字一致
GSV_REF_AUDIO=yukino/Yukino/参考音频/001.あなたいきなり姉さんのこと言い当てるから驚いたわ.wav
GSV_PROMPT_TEXT=あなたいきなり姉さんのこと言い当てるから驚いたわ。
GSV_PROMPT_LANG=ja
# 权重（相对 yukino_voice/GPT-SoVITS-v2pro-20250604/）
GSV_GPT_WEIGHTS=GPT_weights/default.ckpt
GSV_SOVITS_WEIGHTS=SoVITS_weights/default.pth
# 语气档位：说话用的 SoVITS 权重（好感度高/低可切换）
GSV_VOICE_STRONG=SoVITS_weights/Yukino_Strong.pth
GSV_VOICE_WEAK=SoVITS_weights/Yukino_Weak_01.pth

# ---------- 应用 ----------
YUKINO_PERSONA=persona/yukino.json
DB_PATH=data/yukino.db
TTS_CACHE_DIR=data/tts_cache
LOG_LEVEL=INFO

# ---------- 流式 / 低延迟开关 ----------
LLM_STREAM=true
TTS_CACHE=true
# 首句预取：拿到第一句立刻合成，不等全文
PREFETCH_FIRST_SENTENCE=true

# TTS_STREAM 默认关闭，这是实测结论，不是保守：
#   api_v2 一旦开流式，服务端会「自动关闭并行推理 + 自动关闭分桶处理」，
#   导致整句合成总耗时反而更长。实测同一句：
#       非流式 synth()          1.28 ~ 2.30 s
#       流式 mode=1 收完整句     2.96 s
#       流式 mode=3 收完整句     4.01 s
#   只有当你实现「边收边播」（WebSocket / 音频队列）时，流式才有意义。
#   当前的终端版和 Streamlit 版都是「整句收完再播」，所以关掉更快。
TTS_STREAM=false
# 以下两个档位只在 TTS_STREAM=true 时生效：1=质量最好最慢 2=折中 3=最快
TTS_FIRST_STREAM_MODE=3
TTS_STREAM_MODE=1

# ---------- TTS 采样参数 ----------
TTS_TOP_K=5
TTS_TOP_P=1.0
TTS_TEMPERATURE=1.0
TTS_SPEED=1.0
TTS_REPETITION_PENALTY=1.35
